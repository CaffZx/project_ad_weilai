# 复制为项目根 .env 或 ad-direction-agent/.env（settings 优先读 ad-direction-agent/.env）

# 数据源: db | mock | csv
DATA_SOURCE=mock

# Doris / StarRocks（DATA_SOURCE=db 时必填）
DB_HOST=
DB_PORT=9030
DB_USER=
DB_PASS=
DB_DATABASE=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEYS=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：启用 LangGraph 编排（默认 false，与经典 Orchestrator 路径等价）
USE_LANGGRAPH=false
