# 复制为 ad-direction-agent/.env

# mcp=走 MCP Skill（playbook.yaml）；db=仅 Doris
DATA_SOURCE=mcp
SKILLS_ENABLED=true
# SKILLS_DIR=  留空则 ../.claude/skills

# Doris 业务数仓
DB_HOST=36.133.119.99
DB_PORT=9030
DB_USER=
DB_PASS=
DB_DATABASE=x_dwd
MCP_DB_HOST=
MCP_RESOLVE_SKU_VIA_DB=true
# MCP 工具失败或返回空表时回落 Doris（与 playbook fallback 一致）
MCP_FALLBACK_TO_DB=true
MCP_FAILOVER_FULL_DB=true
# 大报表工具（如 ad_keyword_report）可能需 10min+，与 MCP_TIMEOUT 对齐
MCP_TOOL_TIMEOUT=1200
MCP_BOOTSTRAP_TIMEOUT=180
MCP_CONTEXT_TIMEOUT=30
DB_FETCH_TIMEOUT=180
DB_FAILOVER_TIMEOUT=300
DB_FLOW_KEYWORD_TIMEOUT=90
MCP_MAX_CONCURRENCY=8
# 关键词报表 match_type：EXACT,BROAD,PHRASE 逗号分隔；留空则不传（全类型）
MCP_KEYWORD_MATCH_TYPES=

MCP_TRANSPORT=http
MCP_GATEWAY_URL=http://streamable-mcpserver.91cyerp.com/mcp
MCP_GATEWAY_TOKEN=
MCP_GATEWAY_HEADER_NAME=X-Api-Key
MCP_TIMEOUT=1200
MCP_RETRIES=1
MCP_DEFAULT_SHOP_ACCOUNT=
MCP_DEFAULT_SITE_CODE=Amazon_US
MCP_DEFAULT_PARENT_SELLER_SKU=

# 长期状态 MySQL（战略/策略/运营输入/P3 推荐）
STATE_BACKEND=mysql
STATE_DB_HOST=127.0.0.1
STATE_DB_PORT=3307
STATE_DB_USER=ad_agent
STATE_DB_PASS=ad_agent_pass
STATE_DB_DATABASE=ad_agent_state

# 短期 ASIN 数据 Redis（2 小时）
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true
REDIS_SHORT_TTL=7200
REDIS_PARTIAL_TTL=900
REDIS_LRU_TTL=30

DB_FLOW_KEYWORD_PREFETCH_LIMIT=150
DB_FLOW_KEYWORD_EXPAND_LIMIT=100
DB_CHILD_ASIN_CAP=80
DB_USE_LEGACY_FLOW_SQL=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

P1_SERVER_HOST=0.0.0.0
P1_SERVER_PORT=8010
